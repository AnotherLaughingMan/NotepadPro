<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><!-- Retargeting knobs: defaults here, overridable via Directory.Build.props -->
    <InstallerTargetAppName Condition="&apos;$(InstallerTargetAppName)&apos; == &apos;&apos;">Notepad Pro</InstallerTargetAppName>
    <InstallerPublisher Condition="&apos;$(InstallerPublisher)&apos; == &apos;&apos;">AnotherLaughingMan</InstallerPublisher>
    <InstallerVersion Condition="&apos;$(InstallerVersion)&apos; == &apos;&apos;">1.4.0</InstallerVersion>
    <PrimaryEmbeddedPackagePath Condition="&apos;$(PrimaryEmbeddedPackagePath)&apos; == &apos;&apos;">..\artifacts\releases\NotepadPro-win-x64-framework-dependent.zip</PrimaryEmbeddedPackagePath>
    <FallbackEmbeddedPackagePath Condition="&apos;$(FallbackEmbeddedPackagePath)&apos; == &apos;&apos;">..\notepadpro_release.zip</FallbackEmbeddedPackagePath>
  </PropertyGroup>
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>InstallMe.Lite</AssemblyName>
    <RootNamespace>InstallMe.Lite</RootNamespace>
  </PropertyGroup>
  <PropertyGroup>
    <Authors>$(InstallerPublisher)</Authors>
    <Description>Graphical installer for $(InstallerTargetAppName) - InstallMe Lite</Description>
    <Company>$(InstallerPublisher)</Company>
    <Product>InstallMe.Lite</Product>
    <Version>$(InstallerVersion)</Version>
    <AssemblyVersion>$(InstallerVersion)</AssemblyVersion>
    <FileVersion>$(InstallerVersion)</FileVersion>
  </PropertyGroup><!-- Include optional embedded release zip if present during publish -->
  <ItemGroup>
    <EmbeddedResource Include="$(PrimaryEmbeddedPackagePath)" Condition="Exists(&apos;$(PrimaryEmbeddedPackagePath)&apos;)"/>
    <EmbeddedResource Include="$(FallbackEmbeddedPackagePath)" Condition="Exists(&apos;$(FallbackEmbeddedPackagePath)&apos;)"/>
  </ItemGroup>
</Project>