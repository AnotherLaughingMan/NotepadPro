<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:NotepadPro.Views"
        xmlns:vm="using:NotepadPro.ViewModels"
        x:Class="NotepadPro.Views.Dialogs.SettingsDialog"
        x:DataType="vm:SettingsViewModel"
        Width="760"
        Height="560"
        WindowStartupLocation="CenterOwner"
        Title="Settings"
        FontSize="{Binding UiFontSize}"
        SystemDecorations="None">
    <Border BorderBrush="{DynamicResource BorderMedium}" BorderThickness="1" CornerRadius="4">
        <Grid RowDefinitions="Auto,*" Background="{DynamicResource PanelBackground}">
            <Border Background="{DynamicResource TitleBarBackground}" Padding="12,8" CornerRadius="4,4,0,0" PointerPressed="OnDragBarPointerPressed">
                <Grid ColumnDefinitions="*,Auto" Height="32">
                    <TextBlock Text="Settings" FontSize="{Binding UiFontSize}" Foreground="{DynamicResource ForegroundPrimary}" VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Width="28"
                            Height="28"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            ToolTip.Tip="Close"
                            Click="OnCloseClick">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{DynamicResource ForegroundPrimary}" />
                    </Button>
                </Grid>
            </Border>

            <views:SettingsView Grid.Row="1" />
        </Grid>
    </Border>
</Window>
