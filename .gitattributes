# Ensure consistent line endings across platforms
* text=auto eol=lf

# Force CRLF for Windows-specific files
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Treat binary files as binary
*.exe binary
*.dll binary
*.pdb binary
*.zip binary
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ttf binary
*.woff binary
*.woff2 binary
